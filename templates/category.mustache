{{!
    @template local_adminhome/category

    One collapsible category with its courses and, inside, its subcategories (this same template, recursively).
    Native <details>/<summary>: expands and collapses with a click or the keyboard, no JavaScript needed.

    Context variables required for this template:
    * name - Category name.
    * issub - Whether it is a subcategory.
    * open - Whether it starts expanded.
    * count - Number of courses in the whole branch, subcategories included.
    * courses - Array of courses, each with: name, url.
    * haschildren - Whether it has subcategories with courses.
    * children - Array of subcategories, with these same variables.

    Example context (json):
    {
        "name": "Category 1",
        "issub": false,
        "open": true,
        "count": 2,
        "courses": [{"name": "Course 1", "url": "https://example.com/course/view.php?id=2"}],
        "haschildren": true,
        "children": [
            {
                "name": "Subcategory 1",
                "issub": true,
                "open": false,
                "count": 1,
                "courses": [{"name": "Course 2", "url": "https://example.com/course/view.php?id=3"}],
                "haschildren": false,
                "children": []
            }
        ]
    }
}}
<details class="local-adminhome-cat {{#issub}}local-adminhome-subcat{{/issub}}" {{#open}}open{{/open}}>
    <summary class="local-adminhome-cat-title">
        <span class="local-adminhome-cat-name">{{name}}</span>
        <span class="local-adminhome-cat-count">{{count}}</span>
    </summary>
    <div class="local-adminhome-cat-body">
        {{#courses}}
            <a class="local-adminhome-course" href="{{url}}">{{name}}</a>
        {{/courses}}
        {{#haschildren}}
            {{#children}}
                {{> local_adminhome/category}}
            {{/children}}
        {{/haschildren}}
    </div>
</details>
