{{!
    @template local_adminhome/main

    Custom home: welcome, site summary cards (site admins) and courses grouped by category.

    Context variables required for this template:
    * iconurl - URL of the plugin icon, shown next to the welcome.
    * welcome - Welcome text with the first name of the user.
    * hascards - Whether the site summary cards are shown (site admins only).
    * cards - Site summary cards, each with icon, label, value and desc.
    * haslinks - Whether the quick links are shown (site admins only).
    * links - Quick links, each with text and url.
    * showfrontpage - Whether the button to the normal frontpage is shown.
    * frontpageurl - URL to view the real frontpage (bypassing the redirect).
    * hascategories - Whether there is at least one category with courses.
    * categories - Array of main categories, as in the template local_adminhome/category.

    Example context (json):
    {
        "iconurl": "https://example.com/local/adminhome/pix/icon.svg",
        "welcome": "Welcome, Ana!",
        "hascards": true,
        "cards": [{"icon": "👥", "label": "Users", "value": "12.402", "desc": "Active accounts"}],
        "haslinks": true,
        "links": [{"text": "Enrol users", "url": "https://example.com/user/index.php"}],
        "showfrontpage": true,
        "frontpageurl": "https://example.com/?noadminhome=1",
        "hascategories": true,
        "categories": [
            {
                "name": "Category 1",
                "issub": false,
                "open": true,
                "count": 1,
                "courses": [{"name": "Course 1", "url": "https://example.com/course/view.php?id=2"}],
                "haschildren": false,
                "children": []
            }
        ]
    }
}}
<div class="local-adminhome">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="local-adminhome-welcome d-flex align-items-center mb-0">
            <img src="{{iconurl}}" alt="" class="local-adminhome-icon me-3 mr-3">
            {{welcome}}
        </h2>
        {{#showfrontpage}}
            <a href="{{frontpageurl}}" class="btn btn-outline-secondary btn-sm">{{#str}} viewfrontpage, local_adminhome {{/str}}</a>
        {{/showfrontpage}}
    </div>

    {{#hascards}}
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 gx-3 mb-2">
            {{#cards}}
                <div class="col mb-3">
                    <div class="local-adminhome-card card h-100">
                        <div class="card-body">
                            <div class="local-adminhome-card-label">
                                <span aria-hidden="true">{{icon}}</span> {{label}}
                            </div>
                            <div class="local-adminhome-card-value">{{value}}</div>
                            <div class="text-muted small">{{desc}}</div>
                        </div>
                    </div>
                </div>
            {{/cards}}
        </div>
    {{/hascards}}

    {{#haslinks}}
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 gx-3 mb-2">
            {{#links}}
                <div class="col mb-3">
                    <a class="local-adminhome-link card h-100" href="{{url}}">
                        <div class="card-body d-flex align-items-center">
                            <span class="me-2 mr-2" aria-hidden="true">🔗</span>{{text}}
                        </div>
                    </a>
                </div>
            {{/links}}
        </div>
    {{/haslinks}}

    {{#hascategories}}
        <div class="local-adminhome-cats">
            {{#categories}}
                {{> local_adminhome/category}}
            {{/categories}}
        </div>
    {{/hascategories}}

    {{^hascategories}}
        <div class="alert alert-info">{{#str}} nocourses, local_adminhome {{/str}}</div>
    {{/hascategories}}
</div>
